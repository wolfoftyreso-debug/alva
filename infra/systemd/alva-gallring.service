# Gallringen som schemalagt jobb (TÜV T-4).
#
# Lagringsbegränsning är en verkställd kontroll, inte en nedskriven
# avsikt — utan schemaläggning läser ingenting gallras_efter. Samma
# regler som faktureringen: egen process, nycklar ur miljöfilen,
# utfallet i journalen.

[Unit]
Description=ALVA retention purge
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=alva
WorkingDirectory=/opt/alva/services/plattform
EnvironmentFile=/etc/alva/miljo
ExecStart=/usr/bin/node gallring.mjs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alva-gallring
