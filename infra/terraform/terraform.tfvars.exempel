# Kopiera till terraform.tfvars och fyll i. Nästan allt kommer från
# AWS-basen — det här är resten.

# Hinken där basens tillstånd ligger. Basen skriver ut namnet:
#   cd ../aws && terraform output -raw ...
tillstandshink = "felsokning-produktion-tfstate-123456789012"
region         = "eu-north-1"

# Commit-SHA från publiceringsflödet. ECR har oföränderliga taggar, så
# en tagg pekar alltid på samma bygge.
bildtagg = "ersatt-med-commit-sha"

miljo = "produktion"

# Stäng självregistrering i produktion.
registrering_oppen = false

# Öppnar en väg från en tenant-administratör in i klustrets interna
# adresser. Sätt bara true om verkstaden har en OEM-server på eget nät.
tillat_interna_uppslag = false

# Självhostad git med egna runners.
gitea = {
  aktiv   = true
  doman   = "git.exempel.se"
  runners = 2
  lagring = "20Gi"
}
